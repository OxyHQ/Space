# Required PostgreSQL connection. The API refuses to boot without it.
DATABASE_URL=postgres://station:station@localhost:5432/oxystation

# API and Oxy identity.
PORT=4001
WEB_URL=http://localhost:3000
OXY_API_URL=https://api.oxy.so
OXYSTATION_PUBLIC_URL=http://localhost:3000

# Optional Redis/Valkey for Socket.IO scale-out.
# REDIS_URL=redis://localhost:6379
# REDIS_CA_CERT=

# Optional S3-compatible storage. Without it, uploads use local disk.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
# AWS_S3_BUCKET=
# AWS_CDN_URL=

# Optional upload limit in bytes.
# UPLOAD_MAX_BYTES=26214400

# Optional browser push.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@oxy.so

# Logging.
# LOG_LEVEL=debug
