# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4001

# PostgreSQL. Local development uses the throwaway server in
# docker-compose.postgres.yml:
#   docker compose -f docker-compose.postgres.yml up -d
#   bun src/db/migrate.ts --target-database=<name> --phase=pre
DATABASE_URL=postgres://station:station@127.0.0.1:5439/oxystation_dev

# Oxy auth. Point at PRODUCTION even in local development — sign-in is a real
# Oxy account, the same as every other Oxy app.
OXY_API_URL=https://api.oxy.so

WEB_URL=http://localhost:8081
APP_URL=http://localhost:8081
API_BASE_URL=http://localhost:4001

# 32 bytes as 64 hex characters. `openssl rand -hex 32`. The process refuses to
# encrypt or decrypt an OAuth token without it, and rejects any other length.
TOKEN_ENCRYPTION_KEY=

# Server-to-server credential. `openssl rand -hex 24`.
SERVICE_SECRET=

# Optional below this line — each feature degrades rather than failing the boot.
REDIS_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
