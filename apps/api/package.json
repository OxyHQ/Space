{
  "name": "@oxystation/api",
  "version": "1.0.0",
  "description": "Oxy Station API - Express backend for the Oxy Station workspace",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:pgdb": "vitest run --config vitest.pgdb.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1055",
    "@aws-sdk/s3-request-presigner": "~3.1055",
    "@oxyhq/core": "^12.11.0",
    "@oxyhq/db": "^0.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "expo-server-sdk": "^6.0.0",
    "express": "^4.21.2",
    "ioredis": "^5.10.0",
    "jsdom": "^28.1.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
